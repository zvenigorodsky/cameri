# Copy to `.env` and adjust. Real environment variables always win.
# The full list, with defaults, is in the README under "Configuration".

# Required. Matches the postgres service in docker/docker-compose.yml.
DATABASE_URL=postgres://cameri:cameri@localhost:5432/cameri

# 32 bytes of base64 — `openssl rand -base64 32`. Signs upload URLs and
# encrypts integration tokens; without it no integration can be configured.
# CAMERI_ENCRYPTION_KEY=

# Shared secret (16+ characters) for dashboard calls that change settings.
# Unset means those calls are refused.
# CAMERI_ADMIN_TOKEN=

# Comma-separated hosts an integration may point at, e.g. a private GitLab.
# CAMERI_INTEGRATION_HOSTS=

# PORT=3000
# PUBLIC_URL=http://localhost:3000
# WEB_URL=http://localhost:5173
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./.cameri-storage
# RUN_STALE_MINUTES=120
